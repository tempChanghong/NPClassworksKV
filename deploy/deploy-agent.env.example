# 复制到服务器的 /etc/npclassworks-deploy-agent.env，并 chmod 600。
# 使用 openssl rand -hex 32 生成，不要提交真实值。
DEPLOY_AGENT_SECRET=replace_with_at_least_32_random_bytes
DEPLOY_AGENT_BACKEND_DIR=/opt/npclassworks/NPClassworksKV
DEPLOY_AGENT_HOST=127.0.0.1
DEPLOY_AGENT_PORT=19090
DEPLOY_AGENT_TIMEOUT_MS=1800000
# 可选；留空时仅写入 systemd journal。
# DEPLOY_AGENT_LOG_PATH=/srv/NPClassworksKV/deploy/runtime/deploy-agent.log
