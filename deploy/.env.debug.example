# 由 pnpm run debug:init 自动生成 deploy/.env.debug。
# 本文件只描述变量，不能直接用于生产部署。
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3031

DEBUG_POSTGRES_PORT=55432
POSTGRES_USER=classworks_debug
POSTGRES_DB=classworks_debug
POSTGRES_PASSWORD=replace_with_generated_debug_secret
DATABASE_URL=postgresql://classworks_debug:replace_with_generated_debug_secret@127.0.0.1:55432/classworks_debug?schema=public

JWT_ALG=HS256
JWT_SECRET=replace_with_generated_debug_secret
REFRESH_TOKEN_SECRET=replace_with_generated_debug_secret
METRICS_TOKEN=replace_with_generated_debug_secret
BOOTSTRAP_SETUP_KEY=replace_with_generated_debug_secret
ALLOW_OAUTH_BOOTSTRAP=false
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
LOCAL_AUTH_BCRYPT_ROUNDS=10
STAFF_IMPORT_HASH_CONCURRENCY=4
STAFF_IMPORT_TRANSACTION_TIMEOUT_MS=120000
