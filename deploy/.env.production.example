# 复制为 deploy/.env.production。不要提交真实密钥。
CLASSWORKS_DOMAIN=newfires.top

# standalone：项目内置 Caddy，占用 80/443；shared：使用服务器现有网关。
DEPLOY_MODE=shared

# 前后端分域时填写后端 HTTPS 根地址；同源部署可留空。
VITE_DEFAULT_KV_SERVER=https://api.newfires.top
CLASSWORKS_API_DOMAIN=api.newfires.top
# 允许访问后端的前端来源，多个来源使用英文逗号分隔。
CORS_ALLOWED_ORIGINS=https://newfires.top

# 共享服务器模式的宿主机回环端口；不会占用 80/443，也不会直接暴露到公网。
SHARED_BACKEND_PORT=13000
SHARED_FRONTEND_PORT=13080

POSTGRES_USER=classworks
POSTGRES_DB=classworks
POSTGRES_PASSWORD=replace_with_a_random_url_safe_value

JWT_ALG=HS256
JWT_SECRET=replace_with_a_different_random_value_at_least_32_chars
REFRESH_TOKEN_SECRET=replace_with_another_random_value_at_least_32_chars
METRICS_TOKEN=replace_with_a_random_value_at_least_32_chars
BOOTSTRAP_SETUP_KEY=replace_with_a_one_time_setup_key_at_least_32_chars
BACKUP_RETENTION_DAYS=14
# 仅兼容旧部署；通常不要开启，否则首个 OAuth 用户可初始化学校。
ALLOW_OAUTH_BOOTSTRAP=false

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
LOCAL_AUTH_BCRYPT_ROUNDS=10
# 批量教师导入：PIN 哈希并发建议不超过 Node 默认线程池大小。
STAFF_IMPORT_HASH_CONCURRENCY=4
STAFF_IMPORT_TRANSACTION_TIMEOUT_MS=120000

# OAuth 为可选备用登录方式；只有学校选择 OAuth 时才需要配置。
# GitHub 回调：https://cs.newfires.top/accounts/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ZEROCAT_CLIENT_ID=
ZEROCAT_CLIENT_SECRET=
STCN_CLIENT_ID=
STCN_CLIENT_SECRET=
HLY_CLIENT_ID=
HLY_CLIENT_SECRET=
DLASS_CLIENT_ID=
DLASS_CLIENT_SECRET=

# 可选遥测。
AXIOM_TOKEN=
AXIOM_DATASET=
