[Unit]
Description=NPClassworks authenticated deployment agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=deploy
Group=deploy
SupplementaryGroups=docker
WorkingDirectory=/
EnvironmentFile=/etc/npclassworks-deploy-agent.env
# Retired checkout-hosted service. Migrate to the protected NPEssentials boundary.
ExecStart=/usr/bin/false
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
