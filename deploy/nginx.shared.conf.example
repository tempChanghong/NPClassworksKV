# 合并到宿主机现有 OpenResty/Nginx 配置。TLS 证书路径由服务器管理员配置。
server {
    listen 443 ssl http2;
    server_name newfires.top;

    # ssl_certificate /path/to/newfires.top/fullchain.pem;
    # ssl_certificate_key /path/to/newfires.top/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:13080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name api.newfires.top;

    # ssl_certificate /path/to/api.newfires.top/fullchain.pem;
    # ssl_certificate_key /path/to/api.newfires.top/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
