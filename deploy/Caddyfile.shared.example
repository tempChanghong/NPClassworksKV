# 将两个站点合并到宿主机现有 Caddy；不要启动项目内置 caddy 容器。
# 前端域名只代理前端，API 域名只代理后端。
{$CLASSWORKS_DOMAIN:newfires.top} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:13080

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), geolocation=(), payment=()"
    }
}

{$CLASSWORKS_API_DOMAIN:api.newfires.top} {
    encode zstd gzip

    @retired {
        path /kv /kv/* /apps /apps/* /devices /devices/* /auth /auth/* /auto-auth /auto-auth/* /accounts/devices /accounts/devices/* /accounts/device/*
    }
    handle @retired {
        respond "Classworks 1 API has been retired" 410
    }

    handle {
        reverse_proxy 127.0.0.1:13000
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
