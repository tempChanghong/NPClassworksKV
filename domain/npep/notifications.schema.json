{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPEP N2 notification 0.2 data shapes",
  "description": "Additional wire constraint: title/content/source lengths are UTF-16 code units (160/8000/120). JSON Schema maxLength alone counts Unicode code points and is insufficient; producers and consumers must enforce the UTF-16 limit.",
  "definitions": {
    "item": {
      "type": "object",
      "properties": {
        "publicationId": {
          "type": "string",
          "maxLength": 191,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "maxLength": 8000
        },
        "priority": {
          "enum": [
            "MINOR",
            "NORMAL",
            "IMPORTANT",
            "URGENT"
          ]
        },
        "publishAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 120
        },
        "popupEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "publicationId",
        "revision",
        "title",
        "content",
        "priority",
        "publishAt",
        "expiresAt",
        "source",
        "popupEnabled"
      ],
      "additionalProperties": false
    },
    "receiptRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "publicationId": {
                "type": "string",
                "maxLength": 191,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "stage": {
                "enum": [
                  "RECEIVED",
                  "DISPLAYED",
                  "DISMISSED"
                ]
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "eventId",
              "publicationId",
              "revision",
              "stage",
              "occurredAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requestId",
        "events"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "pollAfterSeconds": {
          "const": 10
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "publicationId": {
                "type": "string",
                "maxLength": 191,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "title": {
                "type": "string",
                "maxLength": 160
              },
              "content": {
                "type": "string",
                "maxLength": 8000
              },
              "priority": {
                "enum": [
                  "MINOR",
                  "NORMAL",
                  "IMPORTANT",
                  "URGENT"
                ]
              },
              "publishAt": {
                "type": "string",
                "format": "date-time"
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 120
              },
              "popupEnabled": {
                "type": "boolean"
              }
            },
            "required": [
              "publicationId",
              "revision",
              "title",
              "content",
              "priority",
              "publishAt",
              "expiresAt",
              "source",
              "popupEnabled"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200
            }
          ]
        }
      },
      "required": [
        "serverTime",
        "pollAfterSeconds",
        "snapshotId",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "receiptResponse": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "status": {
                "enum": [
                  "ACCEPTED",
                  "DUPLICATE",
                  "REJECTED"
                ]
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "eventId",
              "status",
              "code"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  }
}
