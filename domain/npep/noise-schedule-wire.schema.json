{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serverInstanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deploymentEpoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deviceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "bindingRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "credentialGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "serverInstanceId",
        "deploymentEpoch",
        "deviceId",
        "bindingRevision",
        "credentialGeneration"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "runId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "statusEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "controlEpoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "identity",
        "runId",
        "sessionId",
        "statusEpoch",
        "controlEpoch"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "days",
        "start",
        "end"
      ],
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$",
          "maxLength": 23
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$",
          "maxLength": 23
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "outcome": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ]
        }
      },
      "required": [
        "commandId",
        "outcome"
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "const": "noise.schedule"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "None",
            "Disabled",
            "Grade",
            "Class"
          ]
        },
        "owner": {
          "enum": [
            "None",
            "Manual",
            "Schedule"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Z_]+$",
          "maxLength": 64
        },
        "schoolNow": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$",
              "maxLength": 23
            },
            {
              "type": "null"
            }
          ]
        },
        "clockReady": {
          "type": "boolean"
        },
        "dateNeedsReview": {
          "type": "boolean"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/definitions/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "anyOf": [
            {
              "$ref": "#/definitions/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "leaseRemainingSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/definitions/receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "capability",
        "version",
        "source",
        "owner",
        "reason",
        "schoolNow",
        "clockReady",
        "dateNeedsReview",
        "window",
        "next",
        "sessionId",
        "leaseRemainingSeconds",
        "receipt"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "source": {
          "enum": [
            "None",
            "Disabled",
            "Grade",
            "Class"
          ]
        },
        "rules": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/rule"
          }
        }
      },
      "required": [
        "version",
        "source",
        "rules"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "window": {
          "$ref": "#/definitions/window"
        }
      },
      "required": [
        "commandId",
        "version",
        "window"
      ]
    },
    "exchangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "#/definitions/status"
        }
      },
      "required": [
        "requestId",
        "context",
        "sequence",
        "status"
      ]
    },
    "exchangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/definitions/policy"
        },
        "leaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "confirmed": {
          "type": "boolean"
        },
        "command": {
          "anyOf": [
            {
              "$ref": "#/definitions/command"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy",
        "leaseSeconds",
        "confirmed",
        "command"
      ]
    },
    "exchangeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "const": "0.7"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "serverTime": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "$ref": "#/definitions/exchangeResponse"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "serverTime",
        "data"
      ]
    },
    "resumeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "maxLength": 64
        },
        "window": {
          "$ref": "#/definitions/window"
        }
      },
      "required": [
        "requestId",
        "version",
        "window"
      ]
    }
  }
}
