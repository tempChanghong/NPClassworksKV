{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "identity": {
      "type": "object",
      "properties": {
        "serverInstanceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "deploymentEpoch": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "bindingRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "credentialGeneration": {
          "const": 1
        }
      },
      "required": [
        "serverInstanceId",
        "deploymentEpoch",
        "deviceId",
        "bindingRevision",
        "credentialGeneration"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "statusEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "identity",
        "runId",
        "sessionId",
        "statusEpoch"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "appInstanceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "appliedHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "type": "boolean"
        },
        "renderAgeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "appInstanceId",
        "sequence",
        "revision",
        "appliedHash",
        "visible",
        "renderAgeMs"
      ],
      "additionalProperties": false
    },
    "manifestRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/definitions/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloaded": {
          "anyOf": [
            {
              "$ref": "#/definitions/downloaded"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requestId",
        "context",
        "version",
        "observation",
        "downloaded"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      },
      "required": [
        "hash",
        "byteCount",
        "width",
        "height",
        "chunks"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,191}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "asset": {
          "anyOf": [
            {
              "$ref": "#/definitions/asset"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "classId",
        "revision",
        "asset"
      ],
      "additionalProperties": false
    },
    "chunkRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      },
      "required": [
        "requestId",
        "context",
        "version",
        "revision",
        "hash",
        "index"
      ],
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "data": {
          "type": "string",
          "maxLength": 21848,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "revision",
        "hash",
        "index",
        "count",
        "data"
      ],
      "additionalProperties": false
    },
    "downloaded": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "revision",
        "hash"
      ],
      "additionalProperties": false
    },
    "uploadStatusRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "requestId",
        "context",
        "version"
      ],
      "additionalProperties": false
    },
    "uploadRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "context": {
          "$ref": "#/definitions/context"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483646
        },
        "image": {
          "type": "string",
          "minLength": 32,
          "maxLength": 2796204,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "requestId",
        "context",
        "version",
        "expectedRevision",
        "image"
      ],
      "additionalProperties": false
    },
    "uploadResult": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,191}$"
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "classId",
        "className",
        "revision",
        "hash"
      ],
      "additionalProperties": false
    }
  }
}
