        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "AUTH_INVALID",
                "CREDENTIAL_EXPIRED",
                "SCHOOL_ADMIN_REQUIRED",
                "CAPABILITY_DENIED",
                "APPROVER_NO_LONGER_AUTHORIZED",
                "NOT_FOUND",
                "INSTANCE_MISMATCH",
                "PAIRING_STATE_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "CREDENTIAL_ID_CONFLICT",
                "BINDING_OCCUPIED",
                "BINDING_CHANGED",
                "REVISION_CONFLICT",
                "SESSION_SUPERSEDED",
                "SEQUENCE_CONFLICT",
                "STALE_SEQUENCE",
                "PAIRING_EXPIRED",
                "PAYLOAD_TOO_LARGE",
                "PROTOCOL_UNSUPPORTED",
                "RATE_LIMITED",
                "TEMPORARILY_UNAVAILABLE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "retryAfterSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "retryAfterSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "serverTime",
        "error"
      ],
      "additionalProperties": false
    },
