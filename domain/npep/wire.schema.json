          "maxLength": 191,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "administrativeClassId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191,
          "pattern": "^[A-Za-z0-9_.:-]+$"
