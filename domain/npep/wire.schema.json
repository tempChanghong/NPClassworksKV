          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "credentialGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "REVOKED",
            "EXPIRED",
            "INVALIDATED"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "const": "device.status"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "credentialExpiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "connectivity": {
          "type": "string",
          "enum": [
            "ONLINE",
            "OFFLINE",
            "UNKNOWN"
          ]
        },
        "lastSeenAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/status"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deviceId",
