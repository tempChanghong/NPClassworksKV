{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:npedutools:npep:noise-schedule-policy",
  "description": "N4.3a domain policy only. Duration and weekly merging require algorithmic validation; this is not the 0.7 HTTP envelope.",
  "$ref": "#/definitions/classPolicy",
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "start", "end"],
      "properties": {
        "days": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "start": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      }
    },
    "classPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": {"enum": ["Inherit", "Override", "Disabled"]},
        "rules": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/rule"}}
      },
      "if": {"properties": {"mode": {"const": "Override"}}},
      "then": {"properties": {"rules": {"minItems": 1}}},
      "else": {"properties": {"rules": {"maxItems": 0}}}
    },
    "gradePolicy": {
      "allOf": [{"$ref": "#/definitions/classPolicy"}, {"properties": {"mode": {"enum": ["Override", "Disabled"]}}}]
    }
  }
}
