{
  "name": "ClassworksKV",
  "version": "1.0.0",
  "codename": "Nijika",
  "codenameZh": "伊地知虹夏",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "NODE_ENV=development nodemon node .bin/www",
    "get-token": "node ./cli/get-token.js",
    "test": "node --test",
    "test:phase1": "node --test tests/academicCatalog.test.js",
    "test:phase2": "node --test tests/organizationImport.test.js",
    "test:phase3": "node --test tests/publication.test.js",
    "deploy:init": "node scripts/init-production-env.js",
    "deploy:check": "node scripts/check-production-env.js",
    "debug:init": "node scripts/init-debug-env.js",
    "debug:db:up": "docker compose --env-file deploy/.env.debug -f docker-compose.debug.yml up -d",
    "debug:db:down": "docker compose --env-file deploy/.env.debug -f docker-compose.debug.yml down",
    "debug:db:status": "docker compose --env-file deploy/.env.debug -f docker-compose.debug.yml ps",
    "debug:prepare": "node --env-file=deploy/.env.debug scripts/prepare-debug.js",
    "debug:server": "node --env-file=deploy/.env.debug ./bin/www"
  },
  "type": "module",
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.205.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.201.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~4.4.1",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "~5.1.0",
    "express-rate-limit": "^7.5.0",
    "http-errors": "~2.0.0",
    "js-base64": "^3.7.7",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.10.0",
    "node-device-detector": "^2.2.4",
    "prom-client": "^15.1.3",
    "pg": "^8.18.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "prisma": "^7.3.0"
  }
}
